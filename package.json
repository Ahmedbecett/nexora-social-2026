{
  "name": "nexora",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "generate:becetti": "node scripts/generate-becetti-site.mjs",
    "dev": "npm run studio:vendor && npm run generate:seo && npm run generate:becetti && vite --host 0.0.0.0",
    "build": "npm run studio:vendor && npm run generate:seo && npm run generate:becetti && vite build",
    "api:local": "node scripts/local-api.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "android:sync": "npm run build && rm -rf dist/download && npx cap sync android",
    "build:webapp": "npm run studio:vendor && npm run generate:seo && npm run generate:becetti && VITE_API_BASE=https://nexora-social-2026.vercel.app vite build",
    "deploy:webapp": "npm run build:webapp && npx firebase-tools@latest deploy --only hosting",
    "cap:sync": "npm run build && rm -rf dist/download && npx cap sync android",
    "apk:build": "cd android && chmod +x gradlew && ./gradlew assembleRelease",
    "test": "node --test tests/*.test.mjs",
    "check:login": "node scripts/check-login-config.mjs",
    "report:apk": "node scripts/inspect-apk.mjs Nexora.apk",
    "studio:vendor": "node scripts/studio-vendor.mjs",
    "studio:api": "node scripts/studio-server.mjs",
    "studio": "node scripts/studio-dev.mjs",
    "smoke": "node scripts/studio-smoke.mjs",
    "windows:check": "node windows/tools/check-windows.mjs",
    "windows:version": "node windows/tools/sync-version.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/cairo": "^5.2.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/grand-hotel": "^5.2.6",
    "@fontsource/newsreader": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.4.17",
    "e2b": "^2.64.0",
    "esbuild-wasm": "^0.25.12",
    "firebase": "^11.10.0",
    "highlight.js": "^11.12.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "vite": "^6.3.6"
  }
}
