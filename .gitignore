# حِزم البناء والاعتماديات
node_modules/
dist/
.vercel/
.DS_Store
*.log

# أدوات التطوير المحلية في الجذر فقط (تحتوي أسراراً حقيقية: توكن Vercel، رابط قاعدة البيانات، أسرار الاختبار)
# لا تُرفع إلى مستودع عام — النمط مثبَّت بالجذر حتى لا يمسّ مجلدات المشروع مثل api/_lib
/_*

# تهيئة Firebase (تحتوي معرّفات OAuth للتطبيق) — تُمرَّر وقت البناء لا تُرفع
android/app/google-services.local.json
# google-services.json مُتتبَّع عمدًا: الـ CI يحتاج إليه، وهو ليس سرًّا
# (مضمَّن داخل كل APK، ونفس مفتاح API موجود أصلًا في api/_lib/firebase.js)
*.jks
*.p12
*.keystore
