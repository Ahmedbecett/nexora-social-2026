{
  "appId": "com.ahmedbecetti.nexora",
  "appName": "Nexora",
  "webDir": "dist",
  "android": {
    "adjustMarginsForEdgeToEdge": "force",
    "allowMixedContent": false,
    "backgroundColor": "#0c1014"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0c1014",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c1014",
      "overlaysWebView": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "phone"
      ]
    }
  }
}