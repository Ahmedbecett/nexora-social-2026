{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 20 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" }
  ],
  "headers": [
    { "source": "/download/(.*)", "headers": [ { "key": "Content-Disposition", "value": "attachment" }, { "key": "Content-Type", "value": "application/vnd.android.package-archive" } ] }
  ]
}
