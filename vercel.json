{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/features.html",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/download.html",
      "permanent": true
    },
    {
      "source": "/download/",
      "destination": "/download.html",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en.html",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/en/about.html",
      "permanent": true
    },
    {
      "source": "/en/features",
      "destination": "/en/features.html",
      "permanent": true
    },
    {
      "source": "/en/download",
      "destination": "/en/download.html",
      "permanent": true
    },
    {
      "source": "/en/faq",
      "destination": "/en/faq.html",
      "permanent": true
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/blog/apk",
      "destination": "/download.html",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/features.html",
      "permanent": true
    },
    {
      "source": "/use",
      "destination": "/features.html",
      "permanent": true
    },
    {
      "source": "/use/:path*",
      "destination": "/features.html",
      "permanent": true
    },
    {
      "source": "/en/blog",
      "destination": "/en/faq.html",
      "permanent": true
    },
    {
      "source": "/en/blog/apk",
      "destination": "/en/download.html",
      "permanent": true
    },
    {
      "source": "/en/blog/:path*",
      "destination": "/en/features.html",
      "permanent": true
    },
    {
      "source": "/en/use",
      "destination": "/en/features.html",
      "permanent": true
    },
    {
      "source": "/en/use/:path*",
      "destination": "/en/features.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/en/privacy.html",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en/cookie-policy",
      "destination": "/en/privacy.html",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/en/about-us",
      "destination": "/en/about.html",
      "permanent": true
    },
    {
      "source": "/help",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/en/help",
      "destination": "/en/faq.html",
      "permanent": true
    },
    {
      "source": "/en/support",
      "destination": "/en/faq.html",
      "permanent": true
    },
    {
      "source": "/apk",
      "destination": "/download.html",
      "permanent": true
    },
    {
      "source": "/en/apk",
      "destination": "/en/download.html",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en.html",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/en.html",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/features/",
      "destination": "/features.html",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/en/about/",
      "destination": "/en/about.html",
      "permanent": true
    },
    {
      "source": "/en/features/",
      "destination": "/en/features.html",
      "permanent": true
    },
    {
      "source": "/en/download/",
      "destination": "/en/download.html",
      "permanent": true
    },
    {
      "source": "/en/faq/",
      "destination": "/en/faq.html",
      "permanent": true
    },
    {
      "source": "/en/privacy/",
      "destination": "/en/privacy.html",
      "permanent": true
    },
    {
      "source": "/becetti",
      "destination": "/becetti/index.html",
      "permanent": true
    },
    {
      "source": "/becetti/",
      "destination": "/becetti/index.html",
      "permanent": true
    },
    {
      "source": "/becetti/en",
      "destination": "/becetti/en/index.html",
      "permanent": true
    },
    {
      "source": "/becetti/fr",
      "destination": "/becetti/fr/index.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icon|favicon|apple-touch-icon)(.*)\\.(png|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/seo.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/monetag-web.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/adsterra-web.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/mascot-ui.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/mascot-avatar.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/windows/ads-config.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
