{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "appAssociation": "NONE",
    "rewrites": [
      { "source": "/robots.txt", "destination": "/robots-webapp.txt" },
      { "source": "/sitemap.xml", "destination": "/sitemap-webapp.xml" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/app-ads.txt",
        "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
      }
    ]
  }
}
